amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

min_hk_version = "1.57.0"

local formatters = new Mapping<String, Step> {
  ["oxfmt"] {
    glob = Builtins.oxfmt.glob
    condition = "exec('test -x node_modules/.bin/oxfmt && printf true || printf false') == 'true'"
    check = new Command {
      argv = List("node_modules/.bin/oxfmt", "--check", "--no-error-on-unmatched-pattern", "{{files}}")
    }
    check_list_files = new Command {
      argv = List("node_modules/.bin/oxfmt", "--list-different", "--no-error-on-unmatched-pattern", "{{files}}")
    }
    fix = new Command {
      argv = List("node_modules/.bin/oxfmt", "--write", "--no-error-on-unmatched-pattern", "{{files}}")
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps = formatters
  }
}
