# OrbStack: must precede any Host block.
Include ~/.orbstack/ssh/config

Host github.com exe.dev *.exe.xyz
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host exe.dev *.exe.xyz
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.dotfiles/user/common/.ssh/exe_known_hosts
    GlobalKnownHostsFile /dev/null
    UpdateHostKeys no

Host *.exe.xyz
    User exedev

# Tailscale SSH
Host agent-controller
    HostName controller.tail1cfa5f.ts.net
    User exedev

Host entire-exe-dev
    HostName entire-exe-dev.tail1cfa5f.ts.net
    User exedev

Host haven
    HostName haven.tail1cfa5f.ts.net
    User exedev
