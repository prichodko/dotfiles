#!/usr/bin/env bash
#MISE description="Apply the native mise machine bootstrap"

set -euo pipefail

task_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
case "$#:${1:-}" in
  0:|1:full) ;;
  *)
    printf 'error: The only valid explicit profile is full.\n' >&2
    exit 1
    ;;
esac

profile="${1:-}"
ignored_config_paths="$HOME/.config/mise/config.toml:$task_root/.config/mise/config.toml"
MISE_IGNORED_CONFIG_PATHS="$ignored_config_paths" MISE_ENV="$profile" \
  mise -C "$task_root" bootstrap --skip-dirty --yes --locked
