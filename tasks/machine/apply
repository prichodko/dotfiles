#!/usr/bin/env bash
#MISE description="Apply the native mise machine bootstrap"

set -euo pipefail

task_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
if (( $# > 0 )); then
  printf 'error: machine apply takes no arguments.\n' >&2
  exit 1
fi

export MISE_IGNORED_CONFIG_PATHS="$HOME/.config/mise/config.toml:$task_root/.config/mise/config.toml"
mise -C "$task_root" --locked exec -- bun install --frozen-lockfile --ignore-scripts
mise -C "$task_root" --locked exec -- bun run tasks/dotfiles/check-source.ts
mise -C "$task_root" bootstrap --skip-dirty --yes --locked
mise -C "$task_root" bootstrap status --missing
mise -C "$task_root" --locked exec -- bun run tasks/machine/refresh-codex.ts
