#!/usr/bin/env bash
if [[ -n "${MISE_TEST_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$MISE_TEST_LOG"
fi
if [[ -n "${MISE_TEST_FAIL_MATCH:-}" && "$*" == *"$MISE_TEST_FAIL_MATCH"* ]]; then
  exit 7
fi
if [[ "${1:-}" == "--version" ]]; then
  printf '2026.10.17 test\n'
  exit 0
fi
if [[ " $* " == *" lock --dry-run --json "* ]]; then
  printf '[]\n'
  exit 0
fi
if [[ " $* " == *" ls --current --json "* ]]; then
  printf '{}\n'
  exit 0
fi
exit 0
